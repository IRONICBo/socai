---
import WorkflowShowcase from './WorkflowShowcase.astro';
import { tiktokPrompt, tiktokVideos, tiktokConcepts } from '../data/tiktok-showcase';
import { tiktokVideosZh, tiktokConceptsZh } from '../data/showcase-locales';
const { language = 'en' } = Astro.props;
const zh = language === 'zh'; const t=(en:string,cn:string)=>zh?cn:en;
const videos = zh?tiktokVideosZh:tiktokVideos; const concepts=zh?tiktokConceptsZh:tiktokConcepts;
const platform=zh?'抖音':'TikTok'; const domain=zh?'douyin.com':'tiktok.com';
const steps=[{label:t('Search videos','搜索视频'),address:domain+' · '+t('Search','搜索')},{label:t('Break down videos','拆解视频'),address:domain+' · '+t('Video','视频')},{label:t('Read comments','阅读评论'),address:domain+' · '+t('Comments','评论')},{label:t('Results','结果'),address:'socai result'}];
---
<WorkflowShowcase id={zh?'douyin-showcase':'tiktok-showcase'} language={language} platform={platform} icon="/platforms/tiktok.png" title={t('Content research','内容研究')} prompt={t(tiktokPrompt,'我们要推出一款适合小户型的 80 厘米升降桌。帮我找抖音上近期的小空间桌搭视频，拆解开头、演示和评论区的问题，给团队 3 个这周就能拍的方案。')} steps={steps}>
 <div class="cs-screen cs-process-screen" data-cs-screen="0" hidden><div class="cs-search-field">⌕ {t('small workspace · standing desk · apartment office','小户型桌搭 · 升降桌 · 居家办公')}</div><div class="tt-video-grid">{[videos[0],videos[2],videos[4]].map((v,i)=><article class={`tt-video tt-video--${i}`}><div class="tt-video-art" aria-hidden="true"><svg viewBox="0 0 100 110" fill="none"><rect x="8" y="43" width="84" height="7" rx="2" stroke="currentColor" stroke-width="2"/><path d="M21 50v44M79 50v44M13 95h16m42 0h16M50 41V30" stroke="currentColor" stroke-width="4"/><rect x="30" y="10" width="40" height="23" rx="2" stroke="currentColor" stroke-width="2"/></svg><span>▷ {v.views}</span></div><strong>{v.title}</strong><p>{v.handle} · {v.age}</p></article>)}</div></div>
 <div class="cs-screen cs-process-screen" data-cs-screen="1" hidden><div class="cs-comment-heading"><strong>{videos[0].title}</strong><span>284k {t('views','播放')}</span></div><div class="tt-breakdown">{concepts[0].shots.map(([time,shot])=><div><span>{time}</span><p>{shot}</p></div>)}</div></div>
 <div class="cs-screen cs-process-screen" data-cs-screen="2" hidden><div class="cs-browser-comments">{[videos[0],videos[2],videos[4]].map(v=><div><span class="cs-reader-avatar">{v.id}</span><p>“{v.signal}”<small>{v.handle}</small></p></div>)}</div></div>
 <div class="cs-screen cs-board" data-cs-screen="3">
  <header class="cs-result-header"><strong>{t('3 ideas to shoot this week','这周就能拍的 3 个方案')}</strong><button class="cs-export" type="button" disabled>{t('Download brief','下载方案')} ↓</button></header>
  <div class="cs-cards tt-concepts">{concepts.map((c,i)=><article class="cs-card tt-concept"><header class="tt-concept-title"><span>0{i+1}</span><h3>{c.title}</h3></header><p class="tt-format">{c.format}</p><blockquote class="tt-hook">“{c.hook}”</blockquote><div class="tt-evidence"><strong>{c.range}</strong><span>{t('reference views','参考播放量')} [{c.sources.join('][')}]</span></div><ol class="tt-shot-list">{c.shots.map(([time,shot])=><li><span>{time}</span><p>{shot}</p></li>)}</ol><details class="cs-post-details"><summary>{t('Evidence & production notes','需求依据与拍摄细节')} +</summary><p class="cs-detail-copy">{c.finding}</p><p class="cs-detail-copy">“{c.question}”</p><p class="cs-detail-copy">{c.cta}</p><p class="cs-detail-copy">{c.check}</p></details></article>)}</div>
  <div class="cs-table-wrap cs-reference-table"><table><thead><tr>{[t('Reference / creator','来源 / 作者'),t('Video','视频'),t('Views','播放'),t('Likes','点赞'),t('Comments','评论')].map(s=><th>{s}</th>)}</tr></thead><tbody>{videos.map(v=><tr><td><strong>[{v.id}] {v.handle}</strong></td><td>{v.title}</td><td>{v.views}</td><td>{v.likes}</td><td>{v.comments}</td></tr>)}</tbody></table></div>
 </div>
</WorkflowShowcase>
