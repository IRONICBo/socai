---
import Analytics from "@vercel/analytics/astro";
import { message } from "../lib/i18n";

interface Props {
    messages: Record<string, Record<string, unknown>>;
    language: string;
    currentYear: number;
    analytics?: boolean;
}

const { messages, language, currentYear, analytics = true } = Astro.props;

const githubUrl = "/github";
const blogPath = "/blog";
const connectPath = "/connect";
const contactPath = "/contact";

const t = (path: string) => message(messages, path, language);
const shared = language === "zh"
    ? { platforms: "平台接入", demo: "网页体验", bookDemo: "预约演示" }
    : { platforms: "platforms", demo: "web demo", bookDemo: "book a demo" };
---

<footer class="site-footer">
    <span>© socai · {currentYear}</span>
    <nav
        aria-label={t("footer.linksAria")}
        data-i18n-aria-label="footer.linksAria"
    >
        <a href={githubUrl}>github</a>
        <a href="/docs/">docs</a>
        <a href="/platforms" data-i18n="footer.platforms">{shared.platforms}</a>
        <a href="/demo" data-i18n="footer.demo">{shared.demo}</a>
        <a href="/book-demo" data-i18n="footer.bookDemo">{shared.bookDemo}</a>
        <a href="https://discord.gg/CpQdA7bwt8">discord</a>
        <a href={blogPath} data-i18n="footer.blog">{t("footer.blog")}</a>
        <a href={connectPath} data-i18n="footer.connect">{t("footer.connect")}</a
        >
        <a href={contactPath} data-i18n="footer.contact">{t("footer.contact")}</a
        >
    </nav>
</footer>
{analytics && <Analytics />}
