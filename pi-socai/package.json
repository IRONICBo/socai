{
  "name": "@socai/pi-tools",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "description": "Experimental Pi tools backed by the existing socai CLI.",
  "exports": {
    ".": "./src/tools.mjs",
    "./extension": "./src/extension.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "harness:contract": "node scripts/run-contract-harness.mjs",
    "harness:live": "node scripts/run-live-harness.mjs",
    "harness:agent": "node scripts/run-agent-harness.mjs",
    "harness:model": "node scripts/run-model-harness.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/extension.mjs"
    ]
  }
}
